# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# environment variables
.env
.env.production

# macOS
.DS_Store

# jetbrains / vscode local settings
.idea/
.vscode/

# regenerated on every deploy by scripts/fetch-ocean-assets.py
# (a snapshot is committed so local dev and offline builds work)
# ~100 MB of full-resolution current tiles, rebuilt by CI once per model
# run and deployed with the site. Far too large to carry in the repo.
public/map/tiles/
public/map/tiles-60m/
public/map/tiles-sst-oisst/
public/map/tiles-sst-navy/
public/map/tiles-sss-navy/
# One tile set per forecast hour. This is the bulk of the site's weight and
# the reason the data wants a repository of its own — see PLAN.md.
public/map/tiles-f[0-9]*h/
public/map/tiles-60m-f[0-9]*h/
public/map/tiles-sst-navy-f[0-9]*h/
public/map/tiles-sss-navy-f[0-9]*h/

# Forecast frames. Built in CI beside the tiles and for the same reason: the
# committed snapshot exists so a local or offline build works, and lead 0 is
# all that needs. Five leads x two depths x three tiers is ~30 MB of JSON
# that would be rewritten by every local pipeline run.
public/map/*-f[0-9]h.json
public/map/*-f[0-9][0-9]h.json
