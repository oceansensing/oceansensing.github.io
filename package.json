{
  "name": "oceansensing-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "C4PO — Collaboratory for Physical Oceanography lab website",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "data": "python3 scripts/fetch-ocean-assets.py",
    "test:map": "node scripts/test-map.mjs",
    "test:clock": "node scripts/test-clock.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run build && npm run check && npm run check:docs && npm run test:units && npm run test:schema && npm run test:contrast && npm run test:map && npm run test:multimap && npm run test:clock",
    "data:currents": "python3 scripts/fetch-currents.py",
    "data:fields": "python3 scripts/fetch-ocean-fields.py",
    "data:wind": "python3 scripts/fetch-wind.py",
    "data:field-tiles": "python3 scripts/fetch-ocean-fields.py --tiles",
    "test:contrast": "node scripts/test-contrast.mjs",
    "data:basemaps": "python3 scripts/sample-basemaps.py",
    "data:tiles": "python3 scripts/fetch-currents.py --tiles",
    "data:bathymetry": "python3 scripts/fetch-bathymetry.py",
    "data:bathy-tiles": "python3 scripts/fetch-bathymetry.py --tiles",
    "data:coastline": "python3 scripts/fetch-coastline.py",
    "test:units": "node scripts/test-units.mjs",
    "test:multimap": "node scripts/test-multimap.mjs",
    "test:schema": "node scripts/test-schema.mjs scripts/fixtures/map"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/chakra-petch": "^5.3.0",
    "@retorquere/bibtex-parser": "^10.0.0",
    "astro": "^7.0.7",
    "leaflet": "^1.9.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/leaflet": "^1.9.22",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3"
  }
}
