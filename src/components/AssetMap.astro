---
/* This site's placement of the ocean map: the markup, the styling, and the
   configuration this page wants. The map itself is src/lib/ocean-map, a
   plain module with no Astro in it — see its README for the options.

   Data comes from /map/*.json, refreshed on every deploy by the scripts in
   scripts/ (see .github/workflows/deploy.yml). Leaflet is bundled from npm
   rather than a CDN. The default basemap is GEBCO's bathymetry, so this page
   does request tiles; readers who would rather not can switch to "Coastline
   only", drawn from a file shipped with the site. */
---

<figure class="map-figure" data-ocean-map>
  <div
    id="asset-map"
    data-ocean-map-canvas
    data-map-storage-key="asset-map-view"
    role="application" aria-label="Map of active hurricanes and uncrewed ocean assets">
    <noscript>
      <p class="fallback">
        This map needs JavaScript. The underlying data is available as
        <a href="/map/ocean-assets.json">ocean-assets.json</a>.
      </p>
    </noscript>
  </div>
  <figcaption>
    <span class="legend">
      <span class="key storm">Hurricane</span>
      <span class="key usv">NOAA USV</span>
      <span class="key glider">IOOS glider</span>
      <span class="key argo">Argo float</span>
      <span class="key current">Surface current</span>
      <span class="key sst" data-sst-key hidden>Sea surface temp</span>
      <span class="field-controls" data-field-controls hidden>
        <label>
          <span class="vh">Colour scale</span>
          <select data-field-map aria-label="Colour scale"></select>
        </label>
        <label>
          <span class="vh">Minimum</span>
          <input type="number" data-field-min step="any" aria-label="Scale minimum" />
        </label>
        <span aria-hidden="true">–</span>
        <label>
          <span class="vh">Maximum</span>
          <input type="number" data-field-max step="any" aria-label="Scale maximum" />
        </label>
        <button type="button" data-field-auto>Auto</button>
      </span>
      <span class="bathy-controls" data-bathy-controls hidden>
        <label>
          Isobaths
          <input
            type="range"
            data-bathy-opacity
            min="10"
            max="100"
            step="5"
            aria-label="Isobath opacity"
          />
        </label>
      </span>
    </span>
    <span class="status" id="map-status" data-map-status>Loading…</span>
  </figcaption>
</figure>

<script>
  /* The map itself lives in src/lib/ocean-map — a plain module with no Astro
     in it, so another project can import it directly. This component is the
     markup and the styling; mountOceanMaps finds every container on the page
     and builds one. */
  import { mountOceanMaps } from '../lib/ocean-map';

  mountOceanMaps();
</script>

<style>
  .map-figure {
    margin: 0 0 var(--space-lg, 1.5rem);
  }

  /* Map colours live here rather than in the script, so switching theme
     restyles every vector layer with no redraw. */
  /* Every var() below carries a fallback lifted from src/styles/tokens.css.
     The map borrows seventeen of the site's design tokens, and exactly one of
     them used to have one — so dropped into a host that does not define them
     it came up with an unstyled control row and invisible text. The site's
     own values still win wherever they exist; the fallbacks only matter
     somewhere else. */
  #asset-map {
    --map-land: #8a949f;
    --map-land-fill: 0.16;
    --map-border: #4a525c;
    --map-border-state: #6b7480;
    --map-grid: #7f8c9b;
    --map-casing: #0d1218;
    --map-casing-opacity: 0.4;
    --map-asset-edge: #10161d;
    --map-tiles: none;
    --map-currents: saturate(0.6);
    --map-eez: saturate(0.4) opacity(0.8);
    --map-measure-halo: #ffffff;
    --map-bathy: #97a2b3;
    --map-bathy-halo: rgba(9, 14, 21, 0.65);
    --map-coast: brightness(0.55) contrast(1.3);
    --map-currents-blend: multiply;

    height: clamp(24rem, 62vh, 40rem);
    border: 1px solid var(--border, #d6dbe0);
    border-radius: var(--radius, 4px);
    background: var(--bg-subtle, #f4f6f8);
    z-index: 0;
  }

  /* A quarter taller on a desktop screen, where there is height to spare and
     the extra goes into ocean rather than chrome. Every term scales, not just
     the vh one, or the clamp would simply pin to the old maximum on a large
     display. Phones keep the shorter map: the same increase there pushes the
     legend and the storm line off the first screen. */
  @media (min-width: 48rem) {
    #asset-map {
      height: clamp(30rem, 77.5vh, 50rem);
    }
  }

  /* Dark mode. Bathymetry imagery is only published light, so the tile
     pane is dimmed rather than inverted — inverting would turn deep water
     pale and read as land. Vector layers lighten to stay legible on it. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) #asset-map {
      --map-land: #6f7b88;
      --map-land-fill: 0.22;
      --map-border: #97a3b2;
      --map-border-state: #7d8896;
      --map-grid: #6d7a88;
      --map-casing: #05080c;
      --map-casing-opacity: 0.55;
      --map-asset-edge: #05080c;
      --map-tiles: brightness(0.62) saturate(0.85) contrast(1.08);
      --map-currents: saturate(0.55) brightness(1.15);
      --map-eez: saturate(0.5) brightness(1.4);
      --map-bathy: #aab4c2;
      --map-bathy-halo: rgba(4, 8, 13, 0.7);
      --map-coast: brightness(1.5) contrast(1.15);
      --map-currents-blend: multiply;
      --map-measure-halo: #e8eef5;
    }
  }

  :global(:root[data-theme='dark']) #asset-map {
    --map-land: #6f7b88;
    --map-land-fill: 0.22;
    --map-border: #97a3b2;
    --map-border-state: #7d8896;
    --map-grid: #6d7a88;
    --map-casing: #05080c;
    --map-casing-opacity: 0.55;
    --map-asset-edge: #05080c;
    --map-tiles: brightness(0.62) saturate(0.85) contrast(1.08);
    --map-currents: saturate(0.55) brightness(1.15);
    --map-eez: saturate(0.5) brightness(1.4);
    --map-bathy: #aab4c2;
    --map-bathy-halo: rgba(4, 8, 13, 0.7);
    --map-coast: brightness(1.5) contrast(1.15);
    --map-currents-blend: multiply;
    --map-measure-halo: #ffffff;
  }

  /* The halo follows the *basemap*, not the theme, and below about ΔL 1.5
     against GEBCO's water it has to. Its job is to carry the line where the
     background is pale — a dark casing under a light line — and at the
     original near-white stroke a dark halo cost nothing on a dark basemap
     either. Two steps darker it does: a dark line inside a dark casing over
     GEBCO's navy is one muddy smudge. So dark basemaps get a light halo and
     the pairing keeps its contrast whichever way the water goes.
     `data-basemap-tone` is already published for the tile dimming below. */
  #asset-map[data-basemap-tone='dark'] {
    --map-bathy-halo: rgba(232, 238, 245, 0.5);
  }

  /* Only light basemaps get dimmed in dark mode — see markBasemapTone. */
  #asset-map[data-basemap-tone='light'] :global(.leaflet-tile-pane) {
    filter: var(--map-tiles);
  }

  #asset-map :global(.map-land) {
    stroke: var(--map-land);
    fill: var(--map-land);
    fill-opacity: var(--map-land-fill);
  }

  #asset-map :global(.map-border-country) {
    stroke: var(--map-border);
    stroke-opacity: 0.8;
    fill: none;
  }

  #asset-map :global(.map-border-state) {
    stroke: var(--map-border-state);
    stroke-opacity: 0.65;
    fill: none;
  }

  #asset-map :global(.map-grid) {
    stroke: var(--map-grid);
    stroke-opacity: 0.35;
    fill: none;
  }

  #asset-map :global(.map-casing) {
    stroke: var(--map-casing);
    stroke-opacity: var(--map-casing-opacity);
    fill: none;
  }

  #asset-map :global(.map-asset) {
    stroke: var(--map-asset-edge);
  }

  /* The measuring line's halo. An outline rather than a feature colour, so
     it is themed here like the track casings instead of being gated — it is
     only ever seen as a fringe around the dark line it sits under. */
  #asset-map :global(.map-measure-halo) {
    stroke: var(--map-measure-halo, #ffffff);
    stroke-opacity: 0.85;
    fill: none;
  }

  #asset-map :global(.measure-control) {
    display: flex;
    align-items: stretch;
  }

  #asset-map :global(.measure-control a) {
    font-size: 1rem;
  }

  #asset-map :global(.measure-control a.active) {
    background: var(--accent, #1f6f8b);
    color: var(--accent-contrast, #ffffff);
  }

  /* Only takes space once there is something to say. */
  #asset-map :global(.measure-readout:not(:empty)) {
    display: flex;
    align-items: center;
    padding: 0 var(--space-xs, 0.5rem);
    background: var(--bg, #ffffff);
    color: var(--text, #12181f);
    border-left: 1px solid var(--border, #d6dbe0);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: var(--text-sm, 0.875rem);
    white-space: nowrap;
  }

  #asset-map :global(.point-readout dl) {
    display: grid;
    grid-template-columns: auto auto;
    gap: 0 var(--space-xs, 0.5rem);
    margin: var(--space-2xs, 0.25rem) 0 0;
  }

  #asset-map :global(.point-readout dt) {
    color: var(--text-muted, #5b6672);
  }

  /* Desaturated so the field reads as texture behind the platforms rather
     than as another thing competing for attention. */
  #asset-map :global(.map-currents) {
    filter: var(--map-currents);
  }

  /* Only the Mercator raster blends. The particle pane must composite
     normally — multiplying near-white particles over the sea is very nearly
     a no-op, and it is also the compositing the contrast gate assumes when
     it checks the ramp against the water. scripts/test-contrast.mjs fails if
     a blend mode reappears on the particle pane. */
  /* The service draws its boundaries in its own colours; these are lines on
     top of a bathymetry, so they are toned to sit with the rest of the map
     rather than shout over it. Themed like the other vector work. */
  #asset-map :global(.map-eez) {
    filter: var(--map-eez);
  }

  /* EMODnet serves the shoreline as neutral grey, so it tints like the EEZ
     tiles do: dark over the light basemaps, light over the dark ones. */
  #asset-map :global(.map-coast) {
    filter: var(--map-coast);
  }

  /* Isobaths. Light grey, which reads over GEBCO's deep navy and over most
     of the colour scales — but not over the light Esri bathymetry, and not
     over a pale stop of a ramp the reader has chosen. No single line colour
     can: that is why this is linework carrying a halo rather than a feature
     colour in the palette, which is the same answer the measuring line and
     the track casings arrived at. Measured, no grey clears ΔE 22 over more
     than half of Esri's water against the gate's 90% bar.

     The halo is a drop-shadow on the pane rather than a second polyline
     underneath every contour: one filter for the whole layer, against
     doubling 235,000 points of geometry. */
  #asset-map :global(.map-bathy) {
    fill: none;
    stroke: var(--map-bathy);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #asset-map :global(.leaflet-bathy-pane) {
    filter: drop-shadow(0 0 0.6px var(--map-bathy-halo));
  }

  /* Vectors in a custom pane render as nothing without this, and nothing is
     all you get to debug with — correct geometry, correct transform, correct
     stroke, zero pixels.

     The site's reset gives every `svg` `max-width: 100%`, and a Leaflet pane
     is a 0x0 absolutely positioned box, so an SVG inside one is clamped to
     0x0 and `overflow: hidden` clips the paths away. Leaflet ships exactly
     this counter-rule itself — but scoped to `.leaflet-overlay-pane`, which
     is why the tracks and markers were never affected and why this only
     appeared on the first custom pane to hold vectors. Written for every
     pane so the next one does not rediscover it. */
  #asset-map :global(.leaflet-pane > svg) {
    max-width: none;
    max-height: none;
  }

  #asset-map :global(.leaflet-currents-raster-pane) {
    mix-blend-mode: var(--map-currents-blend);
  }

  .fallback {
    padding: var(--space-md, 1rem);
    color: var(--text-muted, #5b6672);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs, 0.5rem) var(--space-md, 1rem);
    margin-block-start: var(--space-xs, 0.5rem);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: var(--text-sm, 0.875rem);
    color: var(--text-muted, #5b6672);
  }

  /* The temperature key is a bar, not a dot: it stands for a continuum, and
     a single swatch would have to pick one temperature to represent all of
     them. The gradient itself is set from the palette in the script. */
  #asset-map-figure .key.sst::before,
  .key.sst::before {
    background: var(--sst-ramp);
    width: 2.4em;
    border-radius: 2px;
  }

  .key.sst[hidden] {
    display: none;
  }

  /* The colour-scale controls sit with the legend rather than on the map:
     number inputs and a select inside a Leaflet control are awkward on a
     touchscreen, and this is where the colour bar they act on already is. */
  .field-controls {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs, 0.25rem);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: var(--text-sm, 0.875rem);
    color: var(--text-muted, #5b6672);
  }

  .field-controls[hidden] {
    display: none;
  }

  .field-controls select,
  .field-controls input,
  .field-controls button {
    font: inherit;
    color: var(--text, #12181f);
    background: var(--bg, #ffffff);
    border: 1px solid var(--border, #d6dbe0);
    border-radius: var(--radius, 4px);
    padding: 0.1rem 0.3rem;
  }

  .field-controls input {
    /* Enough for -12.5 or 38.5, no more — these are two- or three-character
       numbers and a default-width number input dwarfs the rest of the row. */
    width: 4.5em;
  }

  .field-controls button {
    cursor: pointer;
  }

  .field-controls button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  /* Isobath opacity, in the same row and for the same reason. Shown only
     while the layer is on — a slider for a layer that is not drawn is a
     control with nothing behind it. */
  .bathy-controls {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs, 0.25rem);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: var(--text-sm, 0.875rem);
    color: var(--text-muted, #5b6672);
  }

  .bathy-controls[hidden] {
    display: none;
  }

  .bathy-controls label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs, 0.25rem);
  }

  .bathy-controls input {
    width: 6em;
    accent-color: var(--accent, #1f6f8b);
  }

  .field-controls button:not(:disabled):hover,
  .field-controls button:not(:disabled):focus-visible {
    background: var(--bg-subtle, #f4f6f8);
  }

  /* Labels the controls need but the layout does not. */
  .field-controls .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md, 1rem);
  }

  .key::before {
    content: '';
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    margin-inline-end: 0.4em;
  }

  .key.storm::before {
    background: #d1495b;
  }

  .key.usv::before {
    background: #f08c00;
  }

  .key.glider::before {
    background: #e8368f;
  }

  .key.argo::before {
    background: #ffd400;
    box-shadow: inset 0 0 0 1px #3d3000;
  }

  /* A slice of the speed colourmap rather than a flat dot — the currents
     are a field, not a point. */
  .key.current::before {
    border-radius: 0.15em;
    width: 1.4em;
    background: linear-gradient(90deg, #ecd7ab, #f5e6ca, #fcf2e3);
  }

  /* Leaflet's chrome, matched to the site's tokens in both themes. */
  #asset-map :global(.leaflet-container) {
    background: var(--bg-subtle, #f4f6f8);
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  #asset-map :global(.leaflet-bar a),
  #asset-map :global(.leaflet-control-layers),
  #asset-map :global(.leaflet-popup-content-wrapper),
  #asset-map :global(.leaflet-popup-tip) {
    background: var(--bg, #ffffff);
    color: var(--text, #12181f);
    border-color: var(--border, #d6dbe0);
  }

  #asset-map :global(.leaflet-bar a:hover) {
    background: var(--bg-subtle, #f4f6f8);
  }

  #asset-map :global(.view-toggle a) {
    width: auto;
    padding-inline: 0.5rem;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: var(--text-sm, 0.875rem);
  }

  #asset-map :global(.leaflet-popup-content) {
    line-height: 1.45;
  }

  #asset-map :global(.leaflet-popup-content .muted) {
    color: var(--text-muted, #5b6672);
  }

  /* Deployment / last fix / position, as a compact label-value grid. */
  /* The hover label: a plain box beside the pointer, nothing more. No arrow,
     because a sticky tooltip moves with the cursor and an arrow chasing it
     reads as jitter. Pointer events off so it can never sit between the
     cursor and the marker it is naming. */
  #asset-map :global(.leaflet-tooltip.map-hover) {
    background: var(--bg, #ffffff);
    color: var(--text, #12181f);
    border: 1px solid var(--border, #d6dbe0);
    border-radius: var(--radius, 4px);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.18);
    padding: 0.15rem 0.4rem;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: var(--text-sm, 0.875rem);
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
  }

  #asset-map :global(.leaflet-tooltip.map-hover::before) {
    display: none;
  }

  /* The ocean block is a second list under the platform's own details, so it
     gets a rule above it — without one the two run together and the water's
     properties read as more fields of the glider. */
  #asset-map :global(.leaflet-popup-content dl.ocean) {
    border-top: 1px solid var(--border, #d6dbe0);
    padding-top: var(--space-2xs, 0.25rem);
    margin-top: var(--space-2xs, 0.25rem);
  }

  #asset-map :global(.leaflet-popup-content dl) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem var(--space-sm, 0.75rem);
    margin-block: var(--space-xs, 0.5rem);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: var(--text-sm, 0.875rem);
  }

  #asset-map :global(.leaflet-popup-content dt) {
    color: var(--text-muted, #5b6672);
  }

  #asset-map :global(.leaflet-popup-content dd) {
    margin: 0;
    white-space: nowrap;
  }

  #asset-map :global(.leaflet-control-attribution) {
    background: var(--bg, #ffffff);
    color: var(--text-muted, #5b6672);
  }

  #asset-map :global(.leaflet-control-attribution a) {
    color: var(--accent, #1f6f8b);
  }

  /* Leaflet's scale bar is a translucent white box by default — the last
     piece of light chrome left on a dark page. */
  #asset-map :global(.leaflet-control-scale-line) {
    background: var(--bg, #ffffff);
    color: var(--text-muted, #5b6672);
    border-color: var(--border, #d6dbe0);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
  }
</style>

