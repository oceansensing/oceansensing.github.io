---
import 'leaflet/dist/leaflet.css';

/* Interactive map of active hurricanes and uncrewed ocean assets.
   Data comes from /map/ocean-assets.json, refreshed on every deploy by
   scripts/fetch-ocean-assets.py (see .github/workflows/deploy.yml).
   Leaflet itself is bundled from npm rather than a CDN. The default
   basemap is Esri's Ocean bathymetry, so this page does request tiles;
   readers who would rather not can switch to "Coastline only", drawn
   from a file shipped with the site. */
---

<figure class="map-figure">
  <div id="asset-map" role="application" aria-label="Map of active hurricanes and uncrewed ocean assets">
    <noscript>
      <p class="fallback">
        This map needs JavaScript. The underlying data is available as
        <a href="/map/ocean-assets.json">ocean-assets.json</a>.
      </p>
    </noscript>
  </div>
  <figcaption>
    <span class="legend">
      <span class="key storm">Hurricane</span>
      <span class="key usv">NOAA USV</span>
      <span class="key glider">IOOS glider</span>
      <span class="key current">Surface current</span>
    </span>
    <span class="status" id="map-status">Loading…</span>
  </figcaption>
</figure>

<script>
  import L from 'leaflet';

  const BASIN: [[number, number], [number, number]] = [
    [7, -100],
    [45, -20],
  ];

  // Magenta rather than teal for gliders: teal vanishes into GEBCO's
  // blue-green, and magenta stays separable from the orange USVs and the
  // red storms under the common forms of colour blindness.
  const GLIDER = '#e8368f';
  const USV = '#f08c00';
  const STORM = '#d1495b';

  const el = document.getElementById('asset-map');
  const status = document.getElementById('map-status');
  if (el) init(el as HTMLElement);

  async function init(host: HTMLElement) {
    const map = L.map(host, {
      worldCopyJump: true,
      minZoom: 2,
      attributionControl: true,
    }).fitBounds(BASIN);

    map.attributionControl.setPrefix('');

    /* Leaflet keeps no route from the element back to the map, so hang it
       here: the headless harness in scripts/test-map.mjs reads it, and it
       makes the map pokeable from the console. Nothing on the page uses it. */
    (host as HTMLElement & { _map?: L.Map })._map = map;

    /* Bathymetry is the default, since the point of the map is where the
       platforms sit relative to the ocean floor. That means tile requests
       to Esri; the coastline layer below is the offline, no-tracking
       alternative and is drawn from a file shipped with the site. */
    const bathymetry = L.tileLayer(
      'https://server.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Base/MapServer/tile/{z}/{y}/{x}',
      { attribution: 'Esri — GEBCO, NOAA, National Geographic', maxZoom: 13 }
    );
    /* Surface currents from Mercator Ocean's global 1/12° analysis-forecast
       (Copernicus Marine GLOBAL_ANALYSISFORECAST_PHY_001_024), served as
       WMTS in EPSG:3857 — which is Leaflet's own projection, so the tiles
       are ordinary XYZ. Leaving the TIME dimension off makes the server
       fall back to its default, and that default is the current hour, so
       the field stays live with no date handling here.

       It gets its own pane between the basemap and the vectors: whichever
       basemap the reader picks, the currents sit above it and below every
       track and marker, so the platforms are never obscured. */
    const CMEMS = 'https://wmts.marine.copernicus.eu/teroWmts';
    const CURRENTS =
      'GLOBAL_ANALYSISFORECAST_PHY_001_024/' +
      'cmems_mod_glo_phy_anfc_0.083deg_PT1H-m_202406/sea_water_velocity';

    const pane = map.createPane('currents');
    pane.style.zIndex = '250';
    pane.style.pointerEvents = 'none';

    const currents = L.tileLayer(
      `${CMEMS}?service=WMTS&request=GetTile&version=1.0.0` +
        `&layer=${encodeURIComponent(CURRENTS)}` +
        `&style=${encodeURIComponent('cmap:speed,vectorStyle:solid')}` +
        '&tilematrixset=EPSG:3857&TileMatrix={z}&TileRow={y}&TileCol={x}&format=image/png',
      {
        pane: 'currents',
        className: 'map-currents',
        /* The speed colourmap paints slow water pale cream, which as a
           straight overlay lays a white film over the whole ocean and
           washes the bathymetry out. Multiplying instead drops that pale
           end away to nothing and keeps only the fast water, so the Gulf
           Stream and the eddy field read as darker streaks over a basemap
           that still looks like itself. Blend mode is set in CSS so each
           theme can pick its own. */
        opacity: 0.55,
        maxNativeZoom: 10,
        attribution: 'Currents: Copernicus Marine — Mercator Ocean',
      }
    );

    const coastline = L.layerGroup();
    const bases: Record<string, L.Layer> = {
      'Bathymetry (Esri Ocean)': bathymetry,
      'Bathymetry (GEBCO)': L.tileLayer.wms('https://wms.gebco.net/mapserv?', {
        layers: 'GEBCO_LATEST',
        format: 'image/png',
        attribution: 'GEBCO Compilation Group',
      }),
      OpenStreetMap: L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 19,
      }),
      'Coastline only (no tracking)': coastline,
    };
    bathymetry.addTo(map);
    currents.addTo(map);

    // Lat/lon grid, every 10°.
    const graticule = L.layerGroup();
    for (let lon = -180; lon <= 180; lon += 10) {
      L.polyline([[-85, lon], [85, lon]], { weight: 0.5, className: 'map-grid' }).addTo(graticule);
    }
    for (let lat = -80; lat <= 80; lat += 10) {
      L.polyline([[lat, -180], [lat, 180]], { weight: 0.5, className: 'map-grid' }).addTo(graticule);
    }

    const borders = L.layerGroup().addTo(map);
    const storms = L.layerGroup().addTo(map);
    const usvs = L.layerGroup().addTo(map);
    const gliders = L.layerGroup().addTo(map);

    L.control
      .layers(bases, {
        'Surface currents (Mercator)': currents,
        'Hurricanes': storms,
        'NOAA USVs': usvs,
        'IOOS gliders': gliders,
        'Country & state borders': borders,
        'Lat/lon grid': graticule,
      })
      .addTo(map);

    L.control.scale({ imperial: false }).addTo(map);

    // View toggle: hurricane basin vs everything currently reporting.
    const Views = L.Control.extend({
      options: { position: 'topleft' },
      onAdd() {
        const bar = L.DomUtil.create('div', 'leaflet-bar view-toggle');
        for (const [label, title] of [
          ['Basin', 'Zoom to the Atlantic and Gulf'],
          ['Global', 'Zoom to every reporting asset'],
        ]) {
          const a = L.DomUtil.create('a', '', bar);
          a.textContent = label;
          a.href = '#';
          a.title = title;
          L.DomEvent.on(a, 'click', (e) => {
            L.DomEvent.stop(e);
            if (label === 'Basin') map.fitBounds(BASIN);
            else fitEverything();
          });
        }
        return bar;
      },
    });
    map.addControl(new Views());

    let allBounds: L.LatLngBounds | null = null;
    const fitEverything = () => {
      if (allBounds && allBounds.isValid()) map.fitBounds(allBounds.pad(0.1));
    };

    // ---- coastline (the offline basemap) and borders (overlay) ----
    const flip = (line: number[][]) => line.map(([x, y]) => [y, x] as [number, number]);

    fetch('/map/coastline.json')
      .then((r) => r.json())
      .then(({ rings }) => {
        const style = { weight: 0.8, className: 'map-land' };
        for (const ring of rings as number[][][]) L.polygon(flip(ring), style).addTo(coastline);
      })
      .catch(() => {});

    fetch('/map/boundaries.json')
      .then((r) => r.json())
      .then(({ countries, states }) => {
        for (const line of states as number[][][]) {
          L.polyline(flip(line), { weight: 0.6, dashArray: '3,3', className: 'map-border-state' }).addTo(borders);
        }
        for (const line of countries as number[][][]) {
          L.polyline(flip(line), { weight: 1, className: 'map-border-country' }).addTo(borders);
        }
      })
      .catch(() => {});

    const stamp = (t?: string) => (t ? `${t.slice(0, 16).replace('T', ' ')}Z` : 'unknown');
    // "· 11 days" — how long the platform has been out at its last fix.
    const elapsed = (from?: string, to?: string) => {
      if (!from || !to) return '';
      const days = Math.floor((Date.parse(to) - Date.parse(from)) / 86400000);
      return Number.isFinite(days) && days >= 0 ? ` · day ${days + 1}` : '';
    };

    // ---- storms and assets ----
    try {
      const data = await (await fetch('/map/ocean-assets.json')).json();
      const pts: [number, number][] = [];
      // Where each storm sits, for the zoom buttons in the status line above.
      const stormAt = new Map<string, [number, number]>();

      for (const s of data.storms ?? []) {
        if (s.cone?.length) {
          L.polygon(flip(s.cone), {
            color: STORM,
            weight: 1,
            fillColor: STORM,
            fillOpacity: 0.12,
          })
            .addTo(storms)
            .bindPopup(`<strong>${s.name}</strong><br>Forecast cone`);
        }
        if (s.track?.length) {
          L.polyline(flip(s.track), {
            color: STORM,
            weight: 2,
            dashArray: '5,4',
          }).addTo(storms);
        }
        if (typeof s.lat === 'number' && typeof s.lon === 'number') {
          pts.push([s.lat, s.lon]);
          stormAt.set(s.id, [s.lat, s.lon]);
          L.circleMarker([s.lat, s.lon], {
            radius: 8,
            color: STORM,
            weight: 2,
            fillColor: STORM,
            fillOpacity: 0.55,
          })
            .addTo(storms)
            .bindPopup(
              `<strong>${s.name}</strong> (${s.classification ?? ''})<br>` +
                `${s.intensityKt ?? '?'} kt · ${s.pressureMb ?? '?'} mb<br>` +
                `Moving ${s.movementDir ?? '?'}° at ${s.movementSpeedKt ?? '?'} kt<br>` +
                (s.advisoryUrl ? `<a href="${s.advisoryUrl}">NHC advisory</a>` : '')
            );
        }
      }

      /* The status line above renders a zoom button per storm. It ships
         hidden and is revealed only here, so it never sits on the page as a
         dead control when the map or the data fails to load. */
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-storm-zoom]')) {
        const at = stormAt.get(button.dataset.stormZoom ?? '');
        if (!at) continue;
        button.hidden = false;
        button.addEventListener('click', () => {
          // Never zoom out from wherever the reader has already got to.
          const zoom = Math.max(map.getZoom(), 5);
          if (!map.hasLayer(storms)) map.addLayer(storms);
          host.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
          if (reduce) map.setView(at, zoom);
          else map.flyTo(at, zoom);
        });
      }

      for (const a of data.assets ?? []) {
        const isUsv = a.kind === 'usv';
        const layer = isUsv ? usvs : gliders;
        const tint = isUsv ? USV : GLIDER;
        pts.push([a.lat, a.lon]);

        // Where it has been over the active window, then where it is now.
        // The track is drawn twice: a dark casing underneath so the line
        // stays legible over pale Esri Ocean and dark GEBCO alike, then the
        // colour on top.
        if (a.track?.length > 1) {
          const path = flip(a.track);
          L.polyline(path, {
            weight: 4.5,
            lineCap: 'round',
            lineJoin: 'round',
            className: 'map-casing',
          }).addTo(layer);
          L.polyline(path, {
            color: tint,
            weight: 2.5,
            opacity: 0.95,
            lineCap: 'round',
            lineJoin: 'round',
          })
            .addTo(layer)
            .bindPopup(`<strong>${a.id}</strong><br>Track, last ${data.activeWindowDays} days`);
        }
        L.circleMarker([a.lat, a.lon], {
          radius: isUsv ? 6 : 4.5,
          weight: 1.2,
          className: 'map-asset',
          fillColor: tint,
          fillOpacity: 0.95,
        })
          .addTo(layer)
          .bindPopup(
            `<strong>${a.id}</strong>` +
              // many DAC datasets title themselves with their own id
              (a.title && a.title !== a.id ? `<br>${a.title}` : '') +
              (a.institution ? `<br><span class="muted">${a.institution}</span>` : '') +
              `<dl>` +
              (a.deployed
                ? `<dt>Deployed</dt><dd>${stamp(a.deployed)}${elapsed(a.deployed, a.time)}</dd>`
                : '') +
              `<dt>Last fix</dt><dd>${stamp(a.time)}</dd>` +
              `<dt>Position</dt><dd>${a.lat.toFixed(3)}, ${a.lon.toFixed(3)}</dd>` +
              `</dl>` +
              `<a href="${a.info}">ERDDAP dataset</a>`
          );
      }

      if (pts.length) allBounds = L.latLngBounds(pts);

      const n = (data.assets ?? []).length;
      const s = (data.storms ?? []).length;
      if (status) {
        const when = (data.updated ?? '').slice(0, 16).replace('T', ' ');
        status.innerHTML =
          `${s} active storm${s === 1 ? '' : 's'} · ${n} assets reporting within ` +
          `${data.activeWindowDays} days · updated ${when}Z`;
      }
    } catch {
      if (status) status.textContent = 'Asset data unavailable.';
    }
  }
</script>

<style>
  .map-figure {
    margin: 0 0 var(--space-lg);
  }

  /* Map colours live here rather than in the script, so switching theme
     restyles every vector layer with no redraw. */
  #asset-map {
    --map-land: #8a949f;
    --map-land-fill: 0.16;
    --map-border: #4a525c;
    --map-border-state: #6b7480;
    --map-grid: #7f8c9b;
    --map-casing: #0d1218;
    --map-casing-opacity: 0.4;
    --map-asset-edge: #10161d;
    --map-tiles: none;
    --map-currents: saturate(0.6);
    --map-currents-blend: multiply;

    height: clamp(24rem, 62vh, 40rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
    z-index: 0;
  }

  /* Dark mode. Bathymetry imagery is only published light, so the tile
     pane is dimmed rather than inverted — inverting would turn deep water
     pale and read as land. Vector layers lighten to stay legible on it. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) #asset-map {
      --map-land: #6f7b88;
      --map-land-fill: 0.22;
      --map-border: #97a3b2;
      --map-border-state: #7d8896;
      --map-grid: #6d7a88;
      --map-casing: #05080c;
      --map-casing-opacity: 0.55;
      --map-asset-edge: #05080c;
      --map-tiles: brightness(0.62) saturate(0.85) contrast(1.08);
      --map-currents: saturate(0.55) brightness(1.15);
      --map-currents-blend: multiply;
    }
  }

  :global(:root[data-theme='dark']) #asset-map {
    --map-land: #6f7b88;
    --map-land-fill: 0.22;
    --map-border: #97a3b2;
    --map-border-state: #7d8896;
    --map-grid: #6d7a88;
    --map-casing: #05080c;
    --map-casing-opacity: 0.55;
    --map-asset-edge: #05080c;
    --map-tiles: brightness(0.62) saturate(0.85) contrast(1.08);
    --map-currents: saturate(0.55) brightness(1.15);
    --map-currents-blend: multiply;
  }

  #asset-map :global(.leaflet-tile-pane) {
    filter: var(--map-tiles);
  }

  #asset-map :global(.map-land) {
    stroke: var(--map-land);
    fill: var(--map-land);
    fill-opacity: var(--map-land-fill);
  }

  #asset-map :global(.map-border-country) {
    stroke: var(--map-border);
    stroke-opacity: 0.8;
    fill: none;
  }

  #asset-map :global(.map-border-state) {
    stroke: var(--map-border-state);
    stroke-opacity: 0.65;
    fill: none;
  }

  #asset-map :global(.map-grid) {
    stroke: var(--map-grid);
    stroke-opacity: 0.35;
    fill: none;
  }

  #asset-map :global(.map-casing) {
    stroke: var(--map-casing);
    stroke-opacity: var(--map-casing-opacity);
    fill: none;
  }

  #asset-map :global(.map-asset) {
    stroke: var(--map-asset-edge);
  }

  /* Desaturated so the field reads as texture behind the platforms rather
     than as another thing competing for attention. */
  #asset-map :global(.map-currents) {
    filter: var(--map-currents);
  }

  #asset-map :global(.leaflet-currents-pane) {
    mix-blend-mode: var(--map-currents-blend);
  }

  .fallback {
    padding: var(--space-md);
    color: var(--text-muted);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    margin-block-start: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .key::before {
    content: '';
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    margin-inline-end: 0.4em;
  }

  .key.storm::before {
    background: #d1495b;
  }

  .key.usv::before {
    background: #f08c00;
  }

  .key.glider::before {
    background: #e8368f;
  }

  /* A slice of the speed colourmap rather than a flat dot — the currents
     are a field, not a point. */
  .key.current::before {
    border-radius: 0.15em;
    width: 1.4em;
    background: linear-gradient(90deg, #f2eddc, #c9c66a, #4a7a34);
  }

  /* Leaflet's chrome, matched to the site's tokens in both themes. */
  #asset-map :global(.leaflet-container) {
    background: var(--bg-subtle);
    font-family: var(--font-sans);
  }

  #asset-map :global(.leaflet-bar a),
  #asset-map :global(.leaflet-control-layers),
  #asset-map :global(.leaflet-popup-content-wrapper),
  #asset-map :global(.leaflet-popup-tip) {
    background: var(--bg);
    color: var(--text);
    border-color: var(--border);
  }

  #asset-map :global(.leaflet-bar a:hover) {
    background: var(--bg-subtle);
  }

  #asset-map :global(.view-toggle a) {
    width: auto;
    padding-inline: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  #asset-map :global(.leaflet-popup-content) {
    line-height: 1.45;
  }

  #asset-map :global(.leaflet-popup-content .muted) {
    color: var(--text-muted);
  }

  /* Deployment / last fix / position, as a compact label-value grid. */
  #asset-map :global(.leaflet-popup-content dl) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem var(--space-sm);
    margin-block: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  #asset-map :global(.leaflet-popup-content dt) {
    color: var(--text-muted);
  }

  #asset-map :global(.leaflet-popup-content dd) {
    margin: 0;
    white-space: nowrap;
  }

  #asset-map :global(.leaflet-control-attribution) {
    background: var(--bg);
    color: var(--text-muted);
  }

  #asset-map :global(.leaflet-control-attribution a) {
    color: var(--accent);
  }

  /* Leaflet's scale bar is a translucent white box by default — the last
     piece of light chrome left on a dark page. */
  #asset-map :global(.leaflet-control-scale-line) {
    background: var(--bg);
    color: var(--text-muted);
    border-color: var(--border);
    font-family: var(--font-mono);
  }
</style>
