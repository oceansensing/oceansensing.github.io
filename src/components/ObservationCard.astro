---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { HAB_DATA, HAB_WIDTHS } from '../config';

interface Props {
  observation: CollectionEntry<'observations'>;
}

const { observation } = Astro.props;
const { title, short, cover, surveys } = observation.data;

/* Rotation pool: the whole photo bank — the cover plus every survey photo.
   Order and starting photo are randomized per page load by the inline
   script below; without JavaScript it still cycles, just in file order. */
const newest = [...surveys].sort((a, b) => b.date.valueOf() - a.date.valueOf());

/* Two sources, one shape. The cover is a local file this repository still
   optimises through astro:assets; the survey photographs live in
   hab-data-repo and were optimised there, so they arrive as filenames and
   their derivatives are addressed by width. Normalising here is what keeps
   the rotation markup below from having to know which is which. */
const stem = (name: string) => name.replace(/\.[a-z0-9]+$/i, '');
const slide = async (photo: { src: string | ImageMetadata; alt: string }) => {
  if (typeof photo.src === 'string') {
    const url = (w: number) => `${HAB_DATA}w${w}/${stem(photo.src as string)}.webp`;
    return {
      key: photo.src,
      url: url(HAB_WIDTHS[0]),
      srcset: HAB_WIDTHS.map((w) => `${url(w)} ${w}w`).join(', '),
      alt: photo.alt,
    };
  }
  const [small, large] = await Promise.all([
    getImage({ src: photo.src, width: 500, format: 'webp' }),
    getImage({ src: photo.src, width: 1000, format: 'webp' }),
  ]);
  return {
    key: photo.src.src,
    url: small.src,
    srcset: `${small.src} 500w, ${large.src} 1000w`,
    alt: photo.alt,
  };
};

const all = await Promise.all(
  [...(cover ? [cover] : []), ...newest.flatMap((s) => s.photos)].map(slide)
);
// The cover usually also appears among the survey photos; show it once. It
// is compared by key rather than by URL, since the two sources build theirs
// differently and the same photograph would otherwise slip through twice.
const unique = all.filter((photo, i) => all.findIndex((o) => o.key === photo.key) === i);

/* Every slide downloads when the page loads, so the rotation takes a
   capped, evenly spaced sample rather than the whole bank — the card stays
   light no matter how many surveys accumulate, while still spanning them.
   The script below shuffles this sample per visit. */
const MAX_SLIDES = 8;
const sampled =
  unique.length <= MAX_SLIDES
    ? unique
    : Array.from(
        { length: MAX_SLIDES },
        (_, i) => unique[Math.round((i * (unique.length - 1)) / (MAX_SLIDES - 1))]!
      );
const photos = sampled.filter(
  (photo, i) => sampled.findIndex((other) => other.key === photo.key) === i
);

/* Photo bank rotates with a pure-CSS crossfade — no JavaScript. Each photo
   holds for HOLD seconds; the whole loop is photos.length * HOLD. The
   keyframe stops depend on how many photos there are, and CSS custom
   properties can't be used for keyframe percentages, so the keyframes are
   generated per card. A negative animation-delay of one fade means photo 0
   is already fully visible at page load (no fade-in from blank). */
const HOLD = 30;
const FADE = 1.5;
const count = photos.length;
const cycle = count * HOLD;
const holdPct = 100 / Math.max(count, 1);
const fadePct = count > 1 ? (FADE / cycle) * 100 : 0;
const anim = `obs-${observation.id.replace(/[^a-z0-9]/gi, '-')}`;
const keyframes =
  count > 1
    ? `@keyframes ${anim}{0%{opacity:0}${fadePct.toFixed(3)}%{opacity:1}` +
      `${holdPct.toFixed(3)}%{opacity:1}${(holdPct + fadePct).toFixed(3)}%{opacity:0}100%{opacity:0}}`
    : '';
---

{count > 1 && <style is:inline set:html={keyframes} />}

<article>
  <a href={`/observations/${observation.id}/`}>
    <div
      class="frame obs-rotate"
      data-hold={HOLD}
      data-fade={FADE}
      data-single={count === 1 ? '' : undefined}
      data-empty={count === 0 ? '' : undefined}
    >
      {
        photos.map((photo, i) => (
          <img
            class="slide"
            src={photo.url}
            srcset={photo.srcset}
            sizes="(max-width: 40rem) 100vw, 540px"
            alt={i === 0 ? photo.alt : ''}
            decoding="async"
            style={`animation-name:${anim};animation-duration:${cycle}s;animation-delay:calc(${i * HOLD}s - ${FADE}s)`}
          />
        ))
      }
    </div>
    <div class="body">
      <h3>{title}</h3>
      <p class="summary">{short}</p>
    </div>
  </a>
</article>

{/* Randomizes the photo order and the starting photo on every page load —
    the one thing CSS can't do on its own. Runs once per page, before
    paint; if it never runs, the CSS rotation still works in file order. */}
<script is:inline>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const frame of document.querySelectorAll('.obs-rotate:not([data-shuffled])')) {
      frame.dataset.shuffled = '';
      const slides = frame.querySelectorAll('.slide');
      if (slides.length < 2) continue;

      const hold = Number(frame.dataset.hold);
      const fade = Number(frame.dataset.fade);
      const order = [...slides.keys()];
      for (let i = order.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [order[i], order[j]] = [order[j], order[i]];
      }

      if (reduce) {
        // No motion: show one photo, still chosen at random.
        slides.forEach((el, k) => {
          el.style.animation = 'none';
          el.style.opacity = order[k] === 0 ? '1' : '0';
        });
        continue;
      }

      // A random offset into the loop picks the photo shown first.
      const offset = Math.random() * order.length * hold;
      slides.forEach((el, k) => {
        el.style.animationDelay = `${(order[k] * hold - fade - offset).toFixed(2)}s`;
      });
    }
  })();
</script>

<style>
  article {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-subtle);
    transition: border-color 0.15s ease;
  }

  article:hover {
    border-color: var(--accent);
  }

  a {
    color: inherit;
    display: block;
    height: 100%;
  }

  a:hover {
    text-decoration: none;
    color: inherit;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--bg-subtle);
    overflow: hidden;
  }

  /* No photos yet: a quiet placeholder rather than a broken-looking gap. */
  .frame[data-empty] {
    background: linear-gradient(140deg, var(--bg-subtle), var(--border));
  }

  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation-iteration-count: infinite;
    animation-timing-function: linear;
  }

  /* A single photo just sits there. */
  .frame[data-single] .slide {
    opacity: 1;
    animation: none;
  }

  .body {
    padding: var(--space-md);
  }

  h3 {
    margin-block-end: var(--space-xs);
  }

  article:hover h3 {
    color: var(--accent);
  }

  .summary {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      animation: none;
      opacity: 0;
    }

    .slide:first-child {
      opacity: 1;
    }
  }
</style>
