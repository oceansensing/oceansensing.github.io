---
import fs from 'node:fs';
import path from 'node:path';
import { stormLines, stormLabel, NO_STORMS, type Storm } from '@c4po/ocean-map/storm-status';

/* One line per active tropical cyclone, rendered at build time so the line
   is right with JavaScript off. AssetMap re-renders it in the browser from
   the data it fetches, which is what keeps it current between builds — the
   deploy only rebuilds hourly, and the auto-reload deliberately waits for
   the reader to be idle, so this markup alone could sit stale for a while.
   Both paths format through packages/ocean-map/storm-status.ts. */

let storms: Storm[] = [];
try {
  const raw = fs.readFileSync(path.resolve('public/map/ocean-assets.json'), 'utf8');
  storms = JSON.parse(raw).storms ?? [];
} catch {
  // No data file yet (a fresh checkout before the first fetch) — say nothing.
}

const active = stormLines(storms);
---

<div class="storm-status" data-storm-status>
  <span class="label">{stormLabel(active.length)}</span>
  {
    active.length === 0 ? (
      <p class="none">{NO_STORMS}</p>
    ) : (
      <ul>
        {active.map((s) => (
          <li>
            {
              /* Opens in its own tab, like the map's popup links: the NHC
                 advisory is another site and a reader following it has not
                 finished with the map. AssetMap rebuilds this list in the
                 browser and must match — see the note there. */
              s.url ? (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${s.name} advisory (opens in a new tab)`}
                >
                  {s.name}
                </a>
              ) : (
                <strong>{s.name}</strong>
              )
            }
            {/* Hidden until AssetMap's script wires it up — without the map
                there is nothing to zoom, so the control should not appear. */}
            <button
              type="button"
              class="zoom"
              data-storm-zoom={s.id}
              title={`Zoom the map to ${s.name}`}
              aria-label={`Zoom the map to ${s.name}`}
              hidden
            >
              🔍
            </button>
            <span class="facts">{s.facts.join(' · ')}</span>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style is:global>
  /* Global rather than Astro-scoped, and keyed off .storm-status, because
     AssetMap rebuilds this list in the browser when newer data arrives.
     Scoped styles hang off a data-astro-cid attribute that client-created
     elements do not carry, so the refreshed line would come back unstyled. */
  .storm-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-md);
    border-block: 1px solid var(--border);
    padding-block: var(--space-sm);
    margin-block-end: var(--space-lg);
  }

  .storm-status .label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .storm-status ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .storm-status li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
  }

  .storm-status li a,
  .storm-status li strong {
    font-weight: 600;
  }

  .storm-status .zoom {
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: none;
    padding: 0.1rem 0.3rem;
    font-size: var(--text-sm);
    line-height: 1;
    cursor: pointer;
  }

  .storm-status .zoom[hidden] {
    display: none;
  }

  .storm-status .zoom:hover,
  .storm-status .zoom:focus-visible {
    border-color: var(--border);
    background: var(--bg-subtle);
  }

  .storm-status .facts,
  .storm-status .none {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .storm-status .none {
    margin: 0;
  }
</style>
