---
/* One dated survey: heading, optional note, and its photo grid. Photos
   arrive pre-prepared by the page — `src` and `srcset` point at
   hab-data-repo, `full` is the lightbox-sized variant, and `when`/`where`
   are the metadata lines the lightbox shows.

   No <Image> here any more. These files are not in this repository, so
   astro:assets has nothing to optimise; the derivatives are made where the
   photographs live and this is a plain <img> with the srcset the page
   assembled. Width and height are carried so the grid does not reflow as
   they load — <Image> used to supply those from the file itself. */
interface Props {
  survey: {
    heading: string;
    location?: string | undefined;
    note?: string | undefined;
    photos: Array<{
      src: string;
      srcset: string;
      alt: string;
      caption?: string | undefined;
      full: string;
      full_file: string;
      when: string;
      where: string;
    }>;
  };
}

const { survey } = Astro.props;
---

<div class="survey">
  <h3>
    {survey.heading}
    {survey.location && <span class="where"> · {survey.location}</span>}
  </h3>
  {survey.note && <p class="note">{survey.note}</p>}
  <div class="gallery">
    {
      survey.photos.map((photo) => (
        <figure>
          {/* Without JavaScript this is just a link to the full-size
              photo; the lightbox intercepts it. */}
          <a
            class="shot"
            href={photo.full}
            data-alt={photo.alt}
            data-when={photo.when}
            data-where={photo.where}
            data-file={photo.full_file}
          >
            <img
              src={photo.src}
              srcset={photo.srcset}
              sizes="(max-width: 40rem) 100vw, 460px"
              alt={photo.alt}
              loading="lazy"
              decoding="async"
            />
          </a>
          {/* Outside the <a class="shot">, not inside it: nested anchors are
              invalid, and a download control within the link the lightbox
              intercepts would open the viewer instead of saving.

              "Full size" rather than "original", deliberately. What is
              served is a 1600 px web export — the camera originals are not
              published anywhere — and calling it the original would promise
              a Phantom 4 Pro frame to anyone who clicked. It carries its own
              copyright metadata. */}
          <a class="get" href={photo.full_file} download aria-label={`Download the full-size photograph: ${photo.alt}`}>
            Download
          </a>
          {photo.caption && <figcaption>{photo.caption}</figcaption>}
        </figure>
      ))
    }
  </div>
</div>

<style>
  .survey {
    margin-block-start: var(--space-lg);
  }

  .survey h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .where {
    font-weight: 400;
    color: var(--text-muted);
  }

  .note {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--prose-width);
    margin-block-start: var(--space-2xs);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-md);
    margin-block-start: var(--space-sm);
  }

  figure {
    margin: 0;
  }

  figure img {
    border-radius: var(--radius);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity 0.15s ease;
  }

  /* Sits over the corner of the photograph, and appears on hover or focus
     rather than always: 95 of these permanently on screen would read as
     chrome over the observations. Always visible on a touchscreen, where
     there is no hover to reveal it — a control nobody can summon is a
     control that does not exist. */
  figure {
    position: relative;
  }

  .get {
    position: absolute;
    top: var(--space-2xs);
    right: var(--space-2xs);
    padding: 0.15rem var(--space-2xs);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  figure:hover .get,
  .get:focus-visible {
    opacity: 1;
  }

  @media (hover: none) {
    .get {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .get {
      transition: none;
    }
  }

  .shot {
    display: block;
    cursor: zoom-in;
  }

  .shot:hover img {
    opacity: 0.88;
  }

  figcaption {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-block-start: var(--space-2xs);
  }
</style>
