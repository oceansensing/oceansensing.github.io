---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/* One dated survey: heading, optional note, and its photo grid. Photos
   arrive pre-prepared by the page — `full` is the lightbox-sized variant,
   `when`/`where` the metadata lines the lightbox shows. */
interface Props {
  survey: {
    heading: string;
    location?: string | undefined;
    note?: string | undefined;
    photos: Array<{
      src: ImageMetadata;
      alt: string;
      caption?: string | undefined;
      full: string;
      when: string;
      where: string;
    }>;
  };
}

const { survey } = Astro.props;
---

<div class="survey">
  <h3>
    {survey.heading}
    {survey.location && <span class="where"> · {survey.location}</span>}
  </h3>
  {survey.note && <p class="note">{survey.note}</p>}
  <div class="gallery">
    {
      survey.photos.map((photo) => (
        <figure>
          {/* Without JavaScript this is just a link to the full-size
              photo; the lightbox intercepts it. */}
          <a
            class="shot"
            href={photo.full}
            data-alt={photo.alt}
            data-when={photo.when}
            data-where={photo.where}
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[500, 1000]}
              sizes="(max-width: 40rem) 100vw, 460px"
            />
          </a>
          {photo.caption && <figcaption>{photo.caption}</figcaption>}
        </figure>
      ))
    }
  </div>
</div>

<style>
  .survey {
    margin-block-start: var(--space-lg);
  }

  .survey h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .where {
    font-weight: 400;
    color: var(--text-muted);
  }

  .note {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--prose-width);
    margin-block-start: var(--space-2xs);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-md);
    margin-block-start: var(--space-sm);
  }

  figure {
    margin: 0;
  }

  figure img {
    border-radius: var(--radius);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity 0.15s ease;
  }

  .shot {
    display: block;
    cursor: zoom-in;
  }

  .shot:hover img {
    opacity: 0.88;
  }

  figcaption {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-block-start: var(--space-2xs);
  }
</style>
