---
/* A live UTC clock, synchronised against the server rather than trusting the
   reader's device. Observation pages timestamp everything in UTC — photo
   times, deployment dates, last fixes — so the clock gives the reader a
   reference to read them against, and it has to be right to be worth having.

   Ships hidden and is revealed by the script: without JavaScript there is no
   clock, which is honest, whereas a frozen build-time stamp would look like
   a running one. */
---

<time id="utc-clock" hidden></time>

<script>
  const el = document.getElementById('utc-clock') as HTMLTimeElement | null;
  if (el) run(el);

  function run(clock: HTMLTimeElement) {
    /* Offset from the device clock to real time. Zero until the first sync
       lands, so the clock starts on the device's own guess and corrects
       itself a moment later. */
    let offset = 0;
    let synced = false;
    let timer: number | undefined;

    const pad = (n: number) => String(n).padStart(2, '0');

    const render = () => {
      const d = new Date(Date.now() + offset);
      clock.dateTime = d.toISOString();
      clock.textContent =
        `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}T` +
        `${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}:${pad(d.getUTCSeconds())} UTC`;
      clock.hidden = false;
    };

    /* Tick on the UTC second boundary rather than every 1000 ms, so the
       display never skips or repeats a second as the timer drifts. Clearing
       first makes this safe to call again: restarting can never leave a
       second chain running alongside the first. */
    const tick = () => {
      window.clearTimeout(timer);
      render();
      const intoSecond = (Date.now() + offset) % 1000;
      timer = window.setTimeout(tick, 1000 - intoSecond + 5);
    };

    /* One measurement of how far the device clock is from the server's.
       Every HTTP response carries a Date header, so a static site needs no
       time API.

       Age is deliberately ignored. The RFC model is that Date is when the
       origin produced the response and Age is how long a cache has held it,
       so the two ought to add — but the CDN in front of this site
       regenerates Date on every response while still counting Age up, and
       adding them then runs the clock ahead by however long the edge has
       held the page. Measured against the live site, Date alone lands
       within a few hundred ms; Date plus Age drifted further with every
       reload. */
    const probe = async () => {
      const url = new URL(location.href);
      url.searchParams.set('_t', String(Date.now()));
      const before = Date.now();
      const res = await fetch(url, { method: 'HEAD', cache: 'no-store' });
      const after = Date.now();

      const header = res.headers.get('date');
      if (!header) throw new Error('no Date header');
      const stamp = Date.parse(header);
      if (!Number.isFinite(stamp)) throw new Error('unparseable Date header');

      /* The header names a whole second, so the instant it describes is
         somewhere inside that second and the middle is the best single
         guess. It describes the moment the response was generated, which
         sits roughly halfway through the round trip. */
      return { offset: stamp + 500 - (before + after) / 2, delay: after - before };
    };

    const sync = async () => {
      const samples = [];
      for (let i = 0; i < 3; i++) {
        try {
          samples.push(await probe());
        } catch {
          // A single failed probe is not worth giving up over.
        }
      }

      if (samples.length) {
        /* The quickest round trip leaves the least room for the two legs to
           differ, so it carries the least error — the same reason NTP
           prefers its lowest-delay sample. */
        const best = samples.reduce((a, b) => (b.delay < a.delay ? b : a));
        /* Ignore jitter below a quarter second, so resyncing never makes the
           display jump back and repeat a second for no real reason. */
        if (!synced || Math.abs(best.offset - offset) > 250) offset = best.offset;
        synced = true;
        clock.title = 'Coordinated Universal Time, synchronised with the server';
      } else if (!synced) {
        // Offline, or a server that withholds the header. The device clock
        // is all that is left; say so rather than implying it was checked.
        offset = 0;
        clock.title =
          'Coordinated Universal Time, from this device — the server could not be reached to check it';
      }
      render();
    };

    void sync();
    tick();

    // Device clocks drift, and a sleeping laptop wakes up wrong.
    window.setInterval(sync, 10 * 60 * 1000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState !== 'visible') {
        window.clearTimeout(timer);
        return;
      }
      void sync();
      tick();
    });
  }
</script>

<style>
  #utc-clock {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    /* Fixed-width digits, so the line does not twitch every second. */
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
