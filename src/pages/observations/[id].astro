---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const observations = await getCollection('observations');
  return observations.map((observation) => ({
    params: { id: observation.id },
    props: { observation },
  }));
}

const { observation } = Astro.props;
const { title, summary, cover, surveys, links } = observation.data;
const { Content } = await render(observation);

/* Survey photos are shown as panels: grouped by year (newest first), then
   by day within each year. */
const dated = surveys
  .filter((s) => s.photos.length > 0)
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const years = [...new Set(dated.map((s) => s.date.getUTCFullYear()))].sort((a, b) => b - a);

const day = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<BaseLayout title={title} description={summary}>
  <article class="container">
    <p class="eyebrow">Significant observation</p>
    <h1>{title}</h1>
    {
      cover && (
        <Image
          class="cover"
          src={cover.src}
          alt={cover.alt}
          widths={[800, 1400]}
          sizes="(max-width: 72rem) 100vw, 1100px"
        />
      )
    }
    <div class="prose">
      <Content />
    </div>

    {
      years.map((year) => (
        <section class="year">
          <h2 class="eyebrow">{year}</h2>
          {dated
            .filter((s) => s.date.getUTCFullYear() === year)
            .map((survey) => (
              <div class="survey">
                <h3>
                  {day(survey.date)}
                  {survey.location && <span class="where"> · {survey.location}</span>}
                </h3>
                {survey.note && <p class="note">{survey.note}</p>}
                <div class="gallery">
                  {survey.photos.map((photo) => (
                    <figure>
                      <Image
                        src={photo.src}
                        alt={photo.alt}
                        widths={[500, 1000]}
                        sizes="(max-width: 40rem) 100vw, 460px"
                      />
                      {photo.caption && <figcaption>{photo.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              </div>
            ))}
        </section>
      ))
    }

    {
      links.length > 0 && (
        <aside>
          <p>
            <span class="eyebrow">Links</span>
            {links.map((l, i) => (
              <>
                {i > 0 && ' · '}
                <a href={l.url}>{l.label}</a>
              </>
            ))}
          </p>
        </aside>
      )
    }
    <p class="back"><a href="/">← Home</a></p>
  </article>
</BaseLayout>

<style>
  article {
    padding-block: var(--space-xl);
  }

  h1 {
    margin-block: var(--space-xs) var(--space-lg);
    max-width: 26ch;
  }

  .cover {
    border-radius: var(--radius);
    margin-block-end: var(--space-lg);
  }

  .year {
    border-top: 1px solid var(--border);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
  }

  .year > h2 {
    font-size: var(--text-base);
    color: var(--text);
  }

  .survey {
    margin-block-start: var(--space-lg);
  }

  .survey h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .where {
    font-weight: 400;
    color: var(--text-muted);
  }

  .note {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--prose-width);
    margin-block-start: var(--space-2xs);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-md);
    margin-block-start: var(--space-sm);
  }

  figure {
    margin: 0;
  }

  figure img {
    border-radius: var(--radius);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  figcaption {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-block-start: var(--space-2xs);
  }

  aside {
    border-top: 1px solid var(--border);
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
  }

  aside p {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .back {
    margin-block-start: var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
