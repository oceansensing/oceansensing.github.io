---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SurveyPanel from '../../components/SurveyPanel.astro';
import AssetMap from '../../components/AssetMap.astro';

export async function getStaticPaths() {
  const observations = await getCollection('observations');
  return observations.map((observation) => ({
    params: { id: observation.id },
    props: { observation },
  }));
}

const { observation } = Astro.props;
const { title, summary, cover, surveys, links, map } = observation.data;
const { Content } = await render(observation);

/* Survey photos are shown as panels: grouped by year (newest first), then
   by day within each year. */
const dated = surveys
  .filter((s) => s.photos.length > 0)
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const day = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });

const coords = (lat: number, lon: number) =>
  `${Math.abs(lat).toFixed(4)}°${lat >= 0 ? 'N' : 'S'}, ${Math.abs(lon).toFixed(4)}°${lon >= 0 ? 'E' : 'W'}`;

/* Prepare each survey for SurveyPanel: a full-size variant per photo for
   the lightbox, plus the two metadata lines it shows. */
const panels = await Promise.all(
  dated.map(async (survey) => ({
    year: survey.date.getUTCFullYear(),
    heading: day(survey.date),
    location: survey.location,
    note: survey.note,
    photos: await Promise.all(
      survey.photos.map(async (photo) => ({
        src: photo.src,
        alt: photo.alt,
        caption: photo.caption,
        full: (await getImage({ src: photo.src, width: 1600, format: 'webp' })).src,
        when: [
          photo.time
            ? `${day(survey.date)}, ${photo.time}${survey.timezone ? ` ${survey.timezone}` : ''}`
            : day(survey.date),
          survey.location,
        ]
          .filter(Boolean)
          .join(' · '),
        where: [
          photo.center && `scene ≈ ${coords(photo.center.lat, photo.center.lon)}`,
          photo.camera &&
            `camera ${coords(photo.camera.lat, photo.camera.lon)}, ${photo.camera.alt} m`,
        ]
          .filter(Boolean)
          .join(' · '),
      }))
    ),
  }))
);

/* Years newest first. With more than one, older years collapse behind a
   <details> so the page stays navigable as surveys accumulate; the newest
   stays open. A lone year needs no disclosure control. */
const byYear = [...new Set(panels.map((p) => p.year))]
  .sort((a, b) => b - a)
  .map((year) => {
    const items = panels.filter((p) => p.year === year);
    const photos = items.reduce((n, p) => n + p.photos.length, 0);
    return {
      year,
      items,
      tally: `${items.length} ${items.length === 1 ? 'survey' : 'surveys'} · ${photos} ${photos === 1 ? 'photo' : 'photos'}`,
    };
  });
const collapsible = byYear.length > 1;
---

<BaseLayout title={title} description={summary}>
  <article class="container">
    <p class="eyebrow">Significant observation</p>
    <h1>{title}</h1>
    {
      cover && (
        <Image
          class="cover"
          src={cover.src}
          alt={cover.alt}
          widths={[800, 1400]}
          sizes="(max-width: 72rem) 100vw, 1100px"
        />
      )
    }
    {map === 'assets' && <AssetMap />}
    <div class="prose">
      <Content />
    </div>

    {
      byYear.map(({ year, items, tally }, i) =>
        collapsible ? (
          <details class="year" open={i === 0}>
            <summary>
              <span class="eyebrow">{year}</span>
              <span class="tally">{tally}</span>
            </summary>
            {items.map((survey) => (
              <SurveyPanel survey={survey} />
            ))}
          </details>
        ) : (
          <section class="year">
            <h2 class="eyebrow">{year}</h2>
            {items.map((survey) => (
              <SurveyPanel survey={survey} />
            ))}
          </section>
        )
      )
    }

    {
      links.length > 0 && (
        <aside>
          <p>
            <span class="eyebrow">Links</span>
            {links.map((l, i) => (
              <>
                {i > 0 && ' · '}
                <a href={l.url}>{l.label}</a>
              </>
            ))}
          </p>
        </aside>
      )
    }
    <p class="back"><a href="/">← Home</a></p>
  </article>

  {
    panels.length > 0 && (
      <dialog id="lightbox" aria-label="Photo viewer">
        <img src="" alt="" />
        <button class="close" type="button" aria-label="Close">&times;</button>
        <button class="nav prev" type="button" aria-label="Previous photo">&lsaquo;</button>
        <button class="nav next" type="button" aria-label="Next photo">&rsaquo;</button>
        <div class="info">
          <p class="when" />
          <p class="where" />
        </div>
        <p class="count" />
      </dialog>
    )
  }
</BaseLayout>

{/* Opens a photo full-size on click. Escape and the backdrop close it,
    arrow keys step through. Without this the thumbnails stay ordinary
    links to the full-size image. */}
<script is:inline>
  (() => {
    const dialog = document.getElementById('lightbox');
    if (!dialog) return;
    const shots = [...document.querySelectorAll('a.shot')];
    if (shots.length === 0) return;

    const img = dialog.querySelector('img');
    const count = dialog.querySelector('.count');
    const when = dialog.querySelector('.when');
    const where = dialog.querySelector('.where');
    let at = 0;

    const show = (k) => {
      at = (k + shots.length) % shots.length;
      const shot = shots[at];
      img.src = shot.getAttribute('href');
      img.alt = shot.dataset.alt ?? '';
      when.textContent = shot.dataset.when ?? '';
      where.textContent = shot.dataset.where ?? '';
      count.textContent = `${at + 1} / ${shots.length}`;
    };

    shots.forEach((shot, k) =>
      shot.addEventListener('click', (event) => {
        event.preventDefault();
        show(k);
        dialog.showModal();
      })
    );

    // Clicking the backdrop (but not the photo or the buttons) closes.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelector('.close').addEventListener('click', () => dialog.close());
    dialog.querySelector('.prev').addEventListener('click', () => show(at - 1));
    dialog.querySelector('.next').addEventListener('click', () => show(at + 1));

    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return;
      if (event.key === 'ArrowLeft') show(at - 1);
      if (event.key === 'ArrowRight') show(at + 1);
    });
  })();
</script>

<style>
  article {
    padding-block: var(--space-xl);
  }

  h1 {
    margin-block: var(--space-xs) var(--space-lg);
    max-width: 26ch;
  }

  .cover {
    border-radius: var(--radius);
    margin-block-end: var(--space-lg);
  }

  /* Body text spans the container here rather than taking the site's
     narrower reading measure — it sits between a full-width hero and a
     full-width photo grid, and the narrow column looked orphaned. */
  .prose {
    max-width: none;
  }

  .year {
    border-top: 1px solid var(--border);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
  }

  .year > h2 {
    font-size: var(--text-base);
    color: var(--text);
  }

  /* ---- collapsible years (only rendered when there is more than one) ---- */

  details.year > summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    cursor: pointer;
    list-style: none;
    padding-block: var(--space-2xs);
  }

  details.year > summary::-webkit-details-marker {
    display: none;
  }

  /* Disclosure triangle, rotating when the year opens. */
  details.year > summary::before {
    content: '';
    flex-shrink: 0;
    align-self: center;
    width: 0;
    height: 0;
    border-left: 0.42rem solid var(--text-muted);
    border-top: 0.3rem solid transparent;
    border-bottom: 0.3rem solid transparent;
    transform-origin: 0.14rem 50%;
    transition: transform 0.15s ease;
  }

  details.year[open] > summary::before {
    transform: rotate(90deg);
  }

  details.year > summary:hover::before {
    border-left-color: var(--accent);
  }

  details.year > summary .eyebrow {
    color: var(--text);
    font-size: var(--text-base);
  }

  .tally {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    details.year > summary::before {
      transition: none;
    }
  }

  /* ---- lightbox ---- */

  #lightbox {
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }

  #lightbox::backdrop {
    background: rgb(0 0 0 / 0.86);
  }

  #lightbox img {
    position: absolute;
    inset: 0 0 3.5rem;
    margin: auto;
    max-width: min(94vw, 1600px);
    max-height: calc(90dvh - 3.5rem);
    width: auto;
    height: auto;
    border-radius: var(--radius);
  }

  #lightbox .info {
    position: absolute;
    bottom: 2.6rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(94vw, 1600px);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  #lightbox .when {
    color: rgb(255 255 255 / 0.92);
  }

  #lightbox .where {
    color: rgb(255 255 255 / 0.6);
  }

  #lightbox .when:empty,
  #lightbox .where:empty {
    display: none;
  }

  #lightbox button {
    position: absolute;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: var(--radius);
    cursor: pointer;
    line-height: 1;
    font-family: var(--font-sans);
  }

  #lightbox button:hover {
    background: rgb(0 0 0 / 0.75);
  }

  #lightbox .close {
    top: var(--space-md);
    right: var(--space-md);
    font-size: 1.6rem;
    width: 2.5rem;
    height: 2.5rem;
  }

  #lightbox .nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 2rem;
    width: 2.75rem;
    height: 3.75rem;
  }

  #lightbox .prev {
    left: var(--space-md);
  }

  #lightbox .next {
    right: var(--space-md);
  }

  #lightbox .count {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    color: rgb(255 255 255 / 0.75);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  @media (max-width: 40rem) {
    #lightbox .nav {
      top: auto;
      bottom: var(--space-md);
      transform: none;
      height: 2.75rem;
    }
  }


  aside {
    border-top: 1px solid var(--border);
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
  }

  aside p {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .back {
    margin-block-start: var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
