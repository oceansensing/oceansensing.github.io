---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const observations = await getCollection('observations');
  return observations.map((observation) => ({
    params: { id: observation.id },
    props: { observation },
  }));
}

const { observation } = Astro.props;
const { title, summary, cover, surveys, links } = observation.data;
const { Content } = await render(observation);

/* Survey photos are shown as panels: grouped by year (newest first), then
   by day within each year. */
const dated = surveys
  .filter((s) => s.photos.length > 0)
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const years = [...new Set(dated.map((s) => s.date.getUTCFullYear()))].sort((a, b) => b - a);

/* Each thumbnail also carries a full-size variant, which the lightbox
   swaps in when the photo is opened. */
const panels = await Promise.all(
  dated.map(async (survey) => ({
    ...survey,
    photos: await Promise.all(
      survey.photos.map(async (photo) => ({
        ...photo,
        full: (await getImage({ src: photo.src, width: 1600, format: 'webp' })).src,
      }))
    ),
  }))
);

const day = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });

const coords = (lat: number, lon: number) =>
  `${Math.abs(lat).toFixed(4)}°${lat >= 0 ? 'N' : 'S'}, ${Math.abs(lon).toFixed(4)}°${lon >= 0 ? 'E' : 'W'}`;
---

<BaseLayout title={title} description={summary}>
  <article class="container">
    <p class="eyebrow">Significant observation</p>
    <h1>{title}</h1>
    {
      cover && (
        <Image
          class="cover"
          src={cover.src}
          alt={cover.alt}
          widths={[800, 1400]}
          sizes="(max-width: 72rem) 100vw, 1100px"
        />
      )
    }
    <div class="prose">
      <Content />
    </div>

    {
      years.map((year) => (
        <section class="year">
          <h2 class="eyebrow">{year}</h2>
          {panels
            .filter((s) => s.date.getUTCFullYear() === year)
            .map((survey) => (
              <div class="survey">
                <h3>
                  {day(survey.date)}
                  {survey.location && <span class="where"> · {survey.location}</span>}
                </h3>
                {survey.note && <p class="note">{survey.note}</p>}
                <div class="gallery">
                  {survey.photos.map((photo) => (
                    <figure>
                      {/* Without JavaScript this is just a link to the
                          full-size photo; the lightbox intercepts it. */}
                      <a
                        class="shot"
                        href={photo.full}
                        data-alt={photo.alt}
                        data-when={[photo.time, survey.location].filter(Boolean).join(' · ')}
                        data-where={[
                          photo.center && `scene ≈ ${coords(photo.center.lat, photo.center.lon)}`,
                          photo.camera &&
                            `camera ${coords(photo.camera.lat, photo.camera.lon)}, ${photo.camera.alt} m`,
                        ]
                          .filter(Boolean)
                          .join(' · ')}
                      >
                        <Image
                          src={photo.src}
                          alt={photo.alt}
                          widths={[500, 1000]}
                          sizes="(max-width: 40rem) 100vw, 460px"
                        />
                      </a>
                      {photo.caption && <figcaption>{photo.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              </div>
            ))}
        </section>
      ))
    }

    {
      links.length > 0 && (
        <aside>
          <p>
            <span class="eyebrow">Links</span>
            {links.map((l, i) => (
              <>
                {i > 0 && ' · '}
                <a href={l.url}>{l.label}</a>
              </>
            ))}
          </p>
        </aside>
      )
    }
    <p class="back"><a href="/">← Home</a></p>
  </article>

  {
    panels.length > 0 && (
      <dialog id="lightbox" aria-label="Photo viewer">
        <img src="" alt="" />
        <button class="close" type="button" aria-label="Close">&times;</button>
        <button class="nav prev" type="button" aria-label="Previous photo">&lsaquo;</button>
        <button class="nav next" type="button" aria-label="Next photo">&rsaquo;</button>
        <div class="info">
          <p class="when" />
          <p class="where" />
        </div>
        <p class="count" />
      </dialog>
    )
  }
</BaseLayout>

{/* Opens a photo full-size on click. Escape and the backdrop close it,
    arrow keys step through. Without this the thumbnails stay ordinary
    links to the full-size image. */}
<script is:inline>
  (() => {
    const dialog = document.getElementById('lightbox');
    if (!dialog) return;
    const shots = [...document.querySelectorAll('a.shot')];
    if (shots.length === 0) return;

    const img = dialog.querySelector('img');
    const count = dialog.querySelector('.count');
    const when = dialog.querySelector('.when');
    const where = dialog.querySelector('.where');
    let at = 0;

    const show = (k) => {
      at = (k + shots.length) % shots.length;
      const shot = shots[at];
      img.src = shot.getAttribute('href');
      img.alt = shot.dataset.alt ?? '';
      when.textContent = shot.dataset.when ?? '';
      where.textContent = shot.dataset.where ?? '';
      count.textContent = `${at + 1} / ${shots.length}`;
    };

    shots.forEach((shot, k) =>
      shot.addEventListener('click', (event) => {
        event.preventDefault();
        show(k);
        dialog.showModal();
      })
    );

    // Clicking the backdrop (but not the photo or the buttons) closes.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelector('.close').addEventListener('click', () => dialog.close());
    dialog.querySelector('.prev').addEventListener('click', () => show(at - 1));
    dialog.querySelector('.next').addEventListener('click', () => show(at + 1));

    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return;
      if (event.key === 'ArrowLeft') show(at - 1);
      if (event.key === 'ArrowRight') show(at + 1);
    });
  })();
</script>

<style>
  article {
    padding-block: var(--space-xl);
  }

  h1 {
    margin-block: var(--space-xs) var(--space-lg);
    max-width: 26ch;
  }

  .cover {
    border-radius: var(--radius);
    margin-block-end: var(--space-lg);
  }

  .year {
    border-top: 1px solid var(--border);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
  }

  .year > h2 {
    font-size: var(--text-base);
    color: var(--text);
  }

  .survey {
    margin-block-start: var(--space-lg);
  }

  .survey h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .where {
    font-weight: 400;
    color: var(--text-muted);
  }

  .note {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: var(--prose-width);
    margin-block-start: var(--space-2xs);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-md);
    margin-block-start: var(--space-sm);
  }

  figure {
    margin: 0;
  }

  figure img {
    border-radius: var(--radius);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity 0.15s ease;
  }

  .shot {
    display: block;
    cursor: zoom-in;
  }

  .shot:hover img {
    opacity: 0.88;
  }

  /* ---- lightbox ---- */

  #lightbox {
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }

  #lightbox::backdrop {
    background: rgb(0 0 0 / 0.86);
  }

  #lightbox img {
    position: absolute;
    inset: 0 0 3.5rem;
    margin: auto;
    max-width: min(94vw, 1600px);
    max-height: calc(90dvh - 3.5rem);
    width: auto;
    height: auto;
    border-radius: var(--radius);
  }

  #lightbox .info {
    position: absolute;
    bottom: 2.6rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(94vw, 1600px);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  #lightbox .when {
    color: rgb(255 255 255 / 0.92);
  }

  #lightbox .where {
    color: rgb(255 255 255 / 0.6);
  }

  #lightbox .when:empty,
  #lightbox .where:empty {
    display: none;
  }

  #lightbox button {
    position: absolute;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: var(--radius);
    cursor: pointer;
    line-height: 1;
    font-family: var(--font-sans);
  }

  #lightbox button:hover {
    background: rgb(0 0 0 / 0.75);
  }

  #lightbox .close {
    top: var(--space-md);
    right: var(--space-md);
    font-size: 1.6rem;
    width: 2.5rem;
    height: 2.5rem;
  }

  #lightbox .nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 2rem;
    width: 2.75rem;
    height: 3.75rem;
  }

  #lightbox .prev {
    left: var(--space-md);
  }

  #lightbox .next {
    right: var(--space-md);
  }

  #lightbox .count {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    color: rgb(255 255 255 / 0.75);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  @media (max-width: 40rem) {
    #lightbox .nav {
      top: auto;
      bottom: var(--space-md);
      transform: none;
      height: 2.75rem;
    }
  }

  figcaption {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-block-start: var(--space-2xs);
  }

  aside {
    border-top: 1px solid var(--border);
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
  }

  aside p {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .back {
    margin-block-start: var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
